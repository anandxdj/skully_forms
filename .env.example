# Database Connection (Default PostgreSQL Docker Setup)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev

# Logger settings
NODE_ENV=development
LOGGER_LEVEL=debug

# Google OAuth Secrets (Replace with real values for production)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# API Server configuration
PORT=8000
BASE_URL=http://localhost:8000

# Web Application configuration (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000

# API Documentation (set to true to expose /docs and /openapi.json)
EXPOSE_DOCS=true
